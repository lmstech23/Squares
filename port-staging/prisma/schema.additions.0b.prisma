// ─────────────────────────────────────────────────────────────
// Phase 0B — Registration / RSVP
// Append after the 0A block.
// ─────────────────────────────────────────────────────────────

enum DaaliActorKind {
  HUMAN
  AGENT

  @@map("daali_actor_kind")
}

enum DaaliRegistrationStatus {
  CONFIRMED
  CANCELLED

  @@map("daali_registration_status")
}

model DaaliRegistration {
  id            String             @id(map: "daali_registrations_pkey") @default(cuid())
  eventId       String
  eventPersonId String
  partySize     Int                @default(1)   // the RSVP plus guests
  status        DaaliRegistrationStatus @default(CONFIRMED)
  note          String?
  createdAt     DateTime           @default(now())
  cancelledAt   DateTime?

  // actor stamp — creation
  actorKind          DaaliActorKind
  actorUserId        String?
  actorEventPersonId String?
  planExecutionId    String?

  // actor stamp — cancellation
  cancelledByKind          DaaliActorKind?
  cancelledByUserId        String?
  cancelledByEventPersonId String?
  cancelledByPlanId        String?

  event  DaaliEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "daali_registrations_eventId_fkey")
  person DaaliEventPerson @relation(fields: [eventPersonId], references: [id], onDelete: Cascade, map: "daali_registrations_eventPersonId_fkey")

  // ⚠️ The one-live-registration rule is a PARTIAL unique index and Prisma cannot
  // express it. It is created by hand in migration 0002:
  //
  //   CREATE UNIQUE INDEX "daali_registrations_live_key"
  //     ON daali_registrations("eventId","eventPersonId") WHERE "status" = 'CONFIRMED';
  //
  // Legal because the predicate reads a column on Registration itself. The signup
  // spec could not do this because its predicate needed slot.slotType from
  // another table. Do not "fix" this by adding @@unique — that would forbid
  // re-RSVP after a cancellation.
  @@index([eventId, status], map: "daali_registrations_eventId_status_idx")
  @@index([eventPersonId], map: "daali_registrations_eventPersonId_idx")

  @@map("daali_registrations")
}

model DaaliEventPersonAccessToken {
  id            String    @id(map: "daali_event_person_access_tokens_pkey") @default(cuid())
  eventPersonId String    @unique(map: "daali_event_person_access_tokens_eventPersonId_key")          // one row per person
  version       Int       @default(1)      // bumped to revoke
  tokenHash     String    @unique(map: "daali_event_person_access_tokens_tokenHash_key")          // sha256 of the derived token
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  person DaaliEventPerson @relation(fields: [eventPersonId], references: [id], onDelete: Cascade, map: "daali_event_person_access_tokens_eventPersonId_fkey")

  @@map("daali_event_person_access_tokens")
}

