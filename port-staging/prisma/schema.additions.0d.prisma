// ─────────────────────────────────────────────────────────────
// Phase 0D.0 — Notification delivery (minimal)
// 0D.1 adds: lockedAt, lockToken, nextAttemptAt — all nullable, all additive.
// ─────────────────────────────────────────────────────────────

enum NotificationType   { RSVP_CONFIRMED }
enum NotificationStatus { pending  sent  failed }

model NotificationDelivery {
  id               String             @id @default(cuid())
  notificationType NotificationType
  /// Names the THING being communicated: "registration:{id}", not the person.
  dedupeKey        String
  eventPersonId    String             // for querying. NOT part of any uniqueness rule
  registrationId   String?
  status           NotificationStatus @default(pending)
  attempts         Int                @default(0)
  providerMessageId String?
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  person       EventPerson   @relation(fields: [eventPersonId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([notificationType, dedupeKey])
  @@index([eventPersonId])
  @@index([status])
}

