// ─────────────────────────────────────────────────────────────
// Phase 0C — Volunteer shifts and item sign-ups
// Plus RegistrationLog, which closes the 0B audit gap.
// ─────────────────────────────────────────────────────────────

enum RegistrationAction {
  CREATED
  PARTY_SIZE_CHANGED
  CANCELLED
  ORGANIZER_REMOVED
}

model RegistrationLog {
  id             String             @id @default(cuid())
  registrationId String
  eventId        String
  eventPersonId  String
  action         RegistrationAction
  fromPartySize  Int?
  toPartySize    Int?
  actorKind          ActorKind
  actorUserId        String?
  actorEventPersonId String?
  planExecutionId    String?
  createdAt      DateTime           @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([eventId])
}

enum SlotType     { SHIFT  ITEM }
enum SignupAction { CLAIMED  CANCELLED  ORGANIZER_REMOVED }

model SignupSheet {
  id           String   @id @default(cuid())
  eventId      String   @unique          // one sheet per event
  title        String?
  instructions String?
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots SignupSlot[]
}

/// One table for both kinds. A shift and an item are the same shape: a named
/// thing with N openings. `capacity` carries both — six people on the gate and
/// six cases of water are both capacity = 6.
model SignupSlot {
  id        String    @id @default(cuid())
  sheetId   String
  slotType  SlotType
  name      String
  startsAt  DateTime?                     // SHIFT only
  endsAt    DateTime?                     // SHIFT only
  capacity  Int
  unitLabel String?                       // ITEM only
  notes     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sheet     SignupSheet            @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  signups   HelperSignup[]
  positions HelperSignupPosition[]   // for _count on the public page

  @@index([sheetId, sortOrder])
}

/// The row a human thinks about. NO quantity column — quantity is
/// count(positions). Storing it would state the same fact twice, and a partial
/// failure leaving quantity=4 against 3 positions is the drift this design refuses.
model HelperSignup {
  id            String   @id @default(cuid())
  slotId        String
  eventPersonId String
  note          String?
  createdAt     DateTime @default(now())
  actorKind          ActorKind
  actorUserId        String?
  actorEventPersonId String?
  planExecutionId    String?

  slot      SignupSlot             @relation(fields: [slotId], references: [id], onDelete: Cascade)
  person    EventPerson            @relation(fields: [eventPersonId], references: [id], onDelete: Cascade)
  positions HelperSignupPosition[]

  @@unique([slotId, eventPersonId])
  @@unique([id, slotId])                 // FK target only — see below
  @@index([eventPersonId])
}

/// The row the database thinks about. One per claimed capacity position.
model HelperSignupPosition {
  id             String @id @default(cuid())
  helperSignupId String
  slotId         String                  // denormalized ON PURPOSE
  position       Int

  // COMPOSITE relation against the parent's @@unique([id, slotId]). Two
  // independent FKs would let a coding error attach one slot's positions to
  // another slot's commitment while satisfying every index.
  signup HelperSignup @relation(fields: [helperSignupId, slotId], references: [id, slotId], onDelete: Cascade)
  slot   SignupSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, position])           // THIS is the capacity guarantee
  @@index([helperSignupId])
}

model SignupLog {
  id            String       @id @default(cuid())
  slotId        String
  eventPersonId String
  action        SignupAction
  positions     Int?
  actorKind          ActorKind
  actorUserId        String?
  actorEventPersonId String?
  planExecutionId    String?
  createdAt     DateTime     @default(now())

  @@index([slotId])
}

