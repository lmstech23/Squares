// ─────────────────────────────────────────────────────────────
// Phase 0A — Event foundation
// Append to prisma/schema.prisma. Touches nothing that exists.
// ─────────────────────────────────────────────────────────────

enum DaaliEventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  // CANCELLED is deliberately absent. See plan §2 [R1].
  // Adding it here breaks the build at every exhaustive switch,
  // which is the review we want.

  @@map("daali_event_status")
}

model DaaliEvent {
  id              String      @id(map: "daali_events_pkey") @default(cuid())
  organizerUserId String
  title           String
  slug            String?     @unique(map: "daali_events_slug_key")          // assigned at publish, not at create
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  timezone        String                        // IANA. never derived from the browser
  venueName       String?
  venueAddress    String?
  status          DaaliEventStatus @default(DRAFT)
  capacity        Int?                          // null = uncapped. enforced in 0B
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  people            DaaliEventPerson[]
  commandExecutions DaaliCommandExecution[]

  @@index([organizerUserId, status], map: "daali_events_organizerUserId_status_idx")

  @@map("daali_events")
}

model DaaliEventPerson {
  id          String   @id(map: "daali_event_people_pkey") @default(cuid())
  eventId     String
  identityKey String                            // normalized email. opaque on purpose
  name        String
  email       String                            // display + delivery. NOT the key
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event DaaliEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "daali_event_people_eventId_fkey")

  @@unique([eventId, identityKey], map: "daali_event_people_eventId_identityKey_key")
  @@index([eventId], map: "daali_event_people_eventId_idx")

  @@map("daali_event_people")
}

model DaaliCommandExecution {
  id             String   @id(map: "daali_command_executions_pkey") @default(cuid())
  commandName    String
  idempotencyKey String
  eventId        String?
  inputHash      String                         // canonical hash of input, ctx excluded
  result         Json                           // the ACTUAL outbound payload [R4]
  createdAt      DateTime @default(now())

  event DaaliEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "daali_command_executions_eventId_fkey")

  @@unique([commandName, idempotencyKey], map: "daali_command_executions_commandName_idempotencyKey_key")
  @@index([eventId], map: "daali_command_executions_eventId_idx")

  @@map("daali_command_executions")
}
