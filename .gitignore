# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...but the example file is documentation, not a secret. Without this it sits
# on disk and nobody cloning ever sees it — the same trap that nearly lost
# add_fundraiser_boards.sql to the *.sql rule below.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Local backups and connection strings — never commit
*.sql
Direct_URL*
*connection*.txt

# ...but migrations are source. Without this, a new migration is silently
# never committed, which is how add_fundraiser_boards.sql nearly got lost.
!migrations/*.sql
# Prisma's own migration directory is a SEPARATE path and was NOT covered by
# the line above. prisma/migrations/0_init/migration.sql was silently ignored —
# the same failure mode, one directory over.
!prisma/migrations/**/*.sql
