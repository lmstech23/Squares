generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Host {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  email                  String   @unique
  stripeAccountId        String?             @map("stripe_account_id")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supabaseUserId         String?  @unique @map("supabase_user_id")
  stripeChargesEnabled   Boolean?  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean?  @default(false) @map("stripe_payouts_enabled")
  boardCredits           Int                 @default(2) @map("board_credits")
  boards                 Board[]
  creditTransactions     CreditTransaction[]
  invite_codes           InviteCode[]

  paymentPreference         String?             @map("payment_preference")

  @@map("hosts")
}

model Board {
  boardId                   String      @id @default(dbgenerated("gen_random_uuid()")) @map("board_id") @db.Uuid
  hostId                    String      @map("host_id") @db.Uuid
  gameName                  String      @map("game_name")
  squarePrice               Int         @map("square_price")
  totalSquares              Int         @default(100) @map("total_squares")
  status                    BoardStatus @default(open)
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  slug                      String      @unique
  rowNumbers                Int[]       @default([]) @map("row_numbers")
  colNumbers                Int[]       @default([]) @map("col_numbers")
  payoutStructure           Json?       @map("payout_structure")
  maxSquaresPerPlayer       Int         @default(10) @map("max_squares_per_player")
  boardCloseTime            DateTime?   @map("board_close_time") @db.Timestamptz(6)
  hostPayoutResponsible     Boolean     @default(true) @map("host_payout_responsible")
  currency                  String      @default("USD")
  teamRow                   String?     @map("team_row")
  teamCol                   String?     @map("team_col")
  periodType                PeriodType  @default(halves) @map("period_type")
  periodLabels              String[]    @default(["H1", "Final"]) @map("period_labels")
  sportType                 SportType   @default(cbb)       @map("sport_type")
  gridType                  GridType    @default(standard)  @map("grid_type")
  rowPairs                  Json?       @map("row_pairs")
  colPairs                  Json?       @map("col_pairs") 
  scoresTeamA               Int[]       @map("scores_team_a")
  scoresTeamB               Int[]       @map("scores_team_b")
  hostCutPercent            Int         @default(0) @map("host_cut_percent")
  cashModeEnabled           Boolean     @default(false) @map("cash_mode_enabled")
  cashPin                   String?     @map("cash_pin")
  cashReservationTtlMins    Int         @default(20) @map("cash_reservation_ttl_mins")
  cashLiabilityAccepted     Boolean     @default(false) @map("cash_liability_accepted")
  winnerNotifiedByPeriod  Json    @default("{}") @map("winner_notified_by_period")
  hostVenmo              String?          @map("host_venmo")
  hostZelle              String?          @map("host_zelle")
  hostCashapp            String?          @map("host_cashapp")
  hostPaypal             String?          @map("host_paypal")
  payoutVisibility       PayoutVisibility @default(public) @map("payout_visibility")
  requirePlayerPayout    Boolean          @default(false) @map("require_player_payout")
  scores                    Json?

  // Monetization lifecycle
  pendingExpiresAt          DateTime?   @map("pending_expires_at") @db.Timestamptz(6)
  expiredAt                 DateTime?   @map("expired_at") @db.Timestamptz(6)
  activatedAt               DateTime?   @map("activated_at") @db.Timestamptz(6)

  // Dismiss feature (Addendum K) � soft-hide from host dashboard
  hiddenFromHost            Boolean     @default(false) @map("hidden_from_host")

  // Fundraiser boards — fundraiser-board-v2.md §3
  // drawTrigger/drawDate/timezone are nullable at the DB level and required
  // by API validation on prize boards only (percent > 0) — the doc's "required"
  // is conditional, so it cannot be a NOT NULL column.
  boardType                 BoardType    @default(game) @map("board_type")
  causeDescription          String?      @map("cause_description")
  prizePoolPercent          Int          @default(0) @map("prize_pool_percent")
  prizeTierCount            Int          @default(4) @map("prize_tier_count")
  drawTrigger               DrawTrigger? @map("draw_trigger")
  drawDate                  DateTime?    @map("draw_date") @db.Timestamptz(6)
  timezone                  String?
  cashHoldDays              Int          @default(7) @map("cash_hold_days")
  finalRaisedCents          Int?         @map("final_raised_cents")
  finalPrizePoolCents       Int?         @map("final_prize_pool_cents")
  drawnAt                   DateTime?    @map("drawn_at") @db.Timestamptz(6)
  drawResults               Json?        @map("draw_results")
  titleHistory              Json?        @map("title_history")
  // Campaign backstop — required on fundraiser boards, API-enforced.
  // drawDate no longer doubles as the campaign end now that prizes are Phase B.
  campaignEndsAt            DateTime?    @map("campaign_ends_at") @db.Timestamptz(6)
  /// Optional, host-entered. Null = no goal and no progress bar. Not locked by
  /// invariant 16 — a goal is aspirational, not a term of the deal. v2 §7.
  fundraisingGoalCents      Int?         @map("fundraising_goal_cents")
  // Early bird — money doc §8B. Null price = flat pricing.
  earlyBirdPriceCents       Int?         @map("early_bird_price_cents")
  earlyBirdEndsAt           DateTime?    @map("early_bird_ends_at") @db.Timestamptz(6)

  host                      Host        @relation(fields: [hostId], references: [id], onUpdate: NoAction)
  squares                   Square[]
  freeEntries               FreeEntry[]
  event                     Event?
  creditTransactions        CreditTransaction[]

  @@index([pendingExpiresAt], map: "idx_boards_pending_expiry")
  @@index([expiredAt], map: "idx_boards_expired_cleanup")
  @@map("boards")
}

model Square {
  squareId          String            @id @default(dbgenerated("gen_random_uuid()")) @map("square_id") @db.Uuid
  boardId           String            @map("board_id") @db.Uuid
  position          Int
  playerName        String?           @map("player_name")
  playerEmail       String?           @map("player_email")
  paymentStatus     PaymentStatus     @default(open) @map("payment_status")
  stripePaymentId   String?           @map("stripe_payment_id")
  checkoutExpiresAt DateTime?         @map("checkout_expires_at") @db.Timestamptz(6)
  releaseReason     ReleaseReason?    @map("release_reason")
  reservedByHost    Boolean?          @default(false) @map("reserved_by_host")
  paymentMethod     PaymentMethod     @default(stripe) @map("payment_method")
  playerPhone           String?              @map("player_phone")
  playerPayoutMethod    PlayerPayoutMethod?  @map("player_payout_method")
  playerPayoutHandle    String?              @map("player_payout_handle")
  smsOptIn              Boolean              @default(false) @map("sms_opt_in")

  // Fundraiser boards — fundraiser-board-v2.md §3
  holdExpiresAt     DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  checkoutSessionId String?           @map("checkout_session_id")
  batchId           String?           @map("batch_id")
  isHostEntry       Boolean           @default(false) @map("is_host_entry")
  /// When the square left `open`. Written alongside pricePaidCents and never
  /// recomputed. PaymentReference.timestamp is the CONFIRMATION moment, which
  /// covers exactly the rows that do not need a date — an awaiting row is the
  /// one a host chases. v2 §9.
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  /// Stamped once this square has been included in a confirmation email. The
  /// unit is the confirmation EVENT, not the square — addendum §5.
  confirmationEmailedAt DateTime?     @map("confirmation_emailed_at") @db.Timestamptz(6)
  /// Written when the square leaves `open` — at claim or cash reservation —
  /// and never recomputed. `raised` sums this, never count × price. Inv. 42–44.
  /// Nullable because an `open` square has no price yet.
  pricePaidCents    Int?              @map("price_paid_cents")

  payment           PaymentReference?
  board             Board             @relation(fields: [boardId], references: [boardId], onUpdate: NoAction)
  /// Back-relation only. The foreign key lives on admission_passes; the
  /// squares table gains no column. Addendum: admission adds none to Square.
  admissionPasses   AdmissionPass[]

  @@unique([boardId, position])
  @@index([boardId, playerEmail], map: "idx_squares_board_email")
  @@index([batchId], map: "idx_squares_batch")
  @@index([boardId, claimedAt], map: "idx_squares_claimed_at")
  @@map("squares")
}

/// Free entries occupy no square, so they cannot be Square rows — v2 §3.
/// Built now, not surfaced in the UI. The `F` sequence is the only sequential
/// counter in the system, and (boardId, sequenceNumber) is the one uniqueness
/// constraint money doc §5 actually calls for.
model FreeEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId        String    @map("board_id") @db.Uuid
  sequenceNumber Int       @map("sequence_number")
  name           String
  phone          String
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  board          Board     @relation(fields: [boardId], references: [boardId], onUpdate: NoAction)

  @@unique([boardId, sequenceNumber])
  @@map("free_entries")
}

//
// Event admission — fundraiser-admission-addendum.md §2 (build step A1b).
// Nothing below is read by any code path yet. Admission is deliberately kept
// off Board, Square, and Host: no column is added to any of them.
//

/// At most one event per board. May start before, on, or after drawDate —
/// no constraint between them.
model Event {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId                  String    @unique @map("board_id") @db.Uuid
  name                     String?
  startsAt                 DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime? @map("ends_at") @db.Timestamptz(6)
  timezone                 String
  venue                    String?
  /// Unused since addendum v2.0 — one square mints one pass, there is no
  /// ceiling. Retained rather than dropped; nullable so event creation does
  /// not have to invent a value.
  maxAttendeesPerSupporter Int?      @map("max_attendees_per_supporter")
  /// Reserved — never read in Phase A. See addendum §5.
  gateAllowanceTotal       Int       @default(0) @map("gate_allowance_total")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  board            Board             @relation(fields: [boardId], references: [boardId], onUpdate: NoAction)
  supporters       EventSupporter[]
  grants           AdmissionGrant[]
  volunteerAccess  VolunteerAccess[]
  checkInLogs      CheckInLog[]

  @@map("events")
}

/// The roster unit and the owner of passes. identityKey is the purchaser email,
/// lowercased and trimmed — two purchases with the same email are one supporter
/// with one allowance between them. status is a latch: pending -> active, never back.
model EventSupporter {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String          @map("event_id") @db.Uuid
  identityKey        String          @map("identity_key")
  name               String
  email              String
  /// Nullable — the claim flow does not require a phone (Square.playerPhone is
  /// nullable too), and preparation must not fail for a contributor without one.
  phone              String?
  declaredCount      Int             @default(0) @map("declared_count")
  /// Monotonic. Never decremented, never reset. Values are never reused.
  passSequenceCursor Int             @default(0) @map("pass_sequence_cursor")
  status             SupporterStatus @default(pending)
  activatedAt        DateTime?       @map("activated_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  event   Event                     @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  grants  AdmissionGrant[]
  passes  AdmissionPass[]
  tokens  AttendanceAccessToken[]

  @@unique([eventId, identityKey])
  @@map("event_supporters")
}

/// Provenance. One row per purchase that touched admission, written even when
/// it declares 0 so the headcount is auditable rather than inferred from absence.
model AdmissionGrant {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String               @map("event_id") @db.Uuid
  eventSupporterId   String               @map("event_supporter_id") @db.Uuid
  /// Links to Square.batchId. Unique where not null — this is what makes the
  /// claim-time preparation step idempotent under retry.
  squareBatchId      String?              @map("square_batch_id")
  /// Only FUNDRAISER is populated now. The rest exist so adding them later is
  /// a code path, not a migration.
  source             AdmissionGrantSource @default(FUNDRAISER)
  /// True mints no passes for this purchase and excludes the supporter from
  /// the headcount — the "I'm not attending" checkbox. Addendum v2.0 §1.
  donateAdmissions   Boolean              @default(false) @map("donate_admissions")
  /// Unused since v2.0 removed the declaration model. Retained, nullable.
  declaredAtPurchase Int?                 @map("declared_at_purchase")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  event     Event          @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  supporter EventSupporter @relation(fields: [eventSupporterId], references: [id], onUpdate: NoAction)

  @@unique([squareBatchId])
  @@index([eventSupporterId], map: "idx_admission_grants_supporter")
  @@map("admission_grants")
}

/// Passes hang off the supporter, not the purchase. Every pass carries its own
/// token whether or not it is ever named — a shared, unidentified QR is one
/// screenshot away from admitting six people.
model AdmissionPass {
  id                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventSupporterId              String              @map("event_supporter_id") @db.Uuid
  /// Internal, not the displayed ordinal. Drawn from passSequenceCursor.
  /// The square that minted this pass. Audit only. Nullable because deferred
  /// non-square sources (STANDALONE, GATE_ALLOWANCE, HOST_APPROVED) mint none.
  squareId                      String?             @map("square_id") @db.Uuid
  sequenceNumber                Int                 @map("sequence_number")
  token                         String              @unique
  label                         String?
  status                        AdmissionPassStatus @default(active)
  checkedInAt                   DateTime?           @map("checked_in_at") @db.Timestamptz(6)
  /// Foreign key, never a bearer token. No raw credential is stored anywhere.
  checkedInByVolunteerAccessId  String?             @map("checked_in_by_volunteer_access_id") @db.Uuid
  createdAt                     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  supporter       EventSupporter   @relation(fields: [eventSupporterId], references: [id], onUpdate: NoAction)
  square          Square?          @relation(fields: [squareId], references: [squareId], onUpdate: NoAction)
  checkedInBy     VolunteerAccess? @relation(fields: [checkedInByVolunteerAccessId], references: [id], onUpdate: NoAction)
  checkInLogs     CheckInLog[]

  /// The constraint behind concurrency-safe activation: concurrent confirmation
  /// cannot double-mint. Safe because the cursor never reuses a value.
  @@unique([eventSupporterId, sequenceNumber])
  @@map("admission_passes")
}

/// Undo has to be auditable or the host stops trusting the count.
model CheckInLog {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId               String        @map("pass_id") @db.Uuid
  eventId              String        @map("event_id") @db.Uuid
  action               CheckInAction
  at                   DateTime      @default(now()) @db.Timestamptz(6)
  byVolunteerAccessId  String        @map("by_volunteer_access_id") @db.Uuid

  pass       AdmissionPass   @relation(fields: [passId], references: [id], onUpdate: NoAction)
  event      Event           @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  byVolunteer VolunteerAccess @relation(fields: [byVolunteerAccessId], references: [id], onUpdate: NoAction)

  @@index([eventId, at], map: "idx_check_in_logs_event_at")
  @@index([passId], map: "idx_check_in_logs_pass")
  @@map("check_in_logs")
}

/// Scoped to one event, revocable individually, grants roster read and check-in
/// only. tokenHash is hashed at rest — the raw link is shown once at creation
/// and never stored, so a database read never yields a working credential.
model VolunteerAccess {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  label     String
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event           @relation(fields: [eventId], references: [id], onUpdate: NoAction)
  checkedInPasses AdmissionPass[]
  checkInLogs  CheckInLog[]

  @@index([eventId], map: "idx_volunteer_access_event")
  @@map("volunteer_access")
}

/// 20-minute single-use link for Manage attendance. Hashed — the raw value
/// exists only in the email. Flow: v2 §6A.
model AttendanceAccessToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventSupporterId String    @map("event_supporter_id") @db.Uuid
  tokenHash        String    @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt           DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  supporter EventSupporter @relation(fields: [eventSupporterId], references: [id], onUpdate: NoAction)

  @@index([eventSupporterId], map: "idx_attendance_tokens_supporter")
  @@map("attendance_access_tokens")
}

model PaymentReference {
  paymentId       String        @id @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  squareId        String        @unique @map("square_id") @db.Uuid
  stripeSessionId String?       @unique @map("stripe_session_id")
  amount          Int
  timestamp       DateTime      @default(now()) @db.Timestamptz(6)
  method          PaymentMethod @default(stripe)
  square          Square        @relation(fields: [squareId], references: [squareId], onUpdate: NoAction)

  @@map("payment_references")
}

model InviteCode {
  code      String    @id
  email     String?
  claimedBy String?   @map("claimed_by") @db.Uuid
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  hosts     Host?     @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invite_codes")
}

model CreditTransaction {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId          String         @map("host_id") @db.Uuid
  type            credit_tx_type
  amount          Int
  balanceAfter    Int            @map("balance_after")
  stripeSessionId String?        @unique @map("stripe_session_id")
  boardId         String?        @map("board_id") @db.Uuid
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  host            Host           @relation(fields: [hostId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board           Board?         @relation(fields: [boardId], references: [boardId], onDelete: SetNull, onUpdate: NoAction)

  @@index([hostId, createdAt], map: "idx_credit_tx_host_created")
  @@map("credit_transactions")
}

enum BoardStatus {
  open
  closed
  pending_payment
  expired
}

enum PaymentStatus {
  open
  pending
  reserved_cash
  paid
  failed
  expired
}

enum ReleaseReason {
  expired
  failed
  manual
}

enum PaymentMethod {
  stripe
  cash
}

enum PayoutVisibility {
  public
  pin_gated
}

enum PlayerPayoutMethod {
  venmo
  zelle
  cashapp
  paypal
  cash
}

enum PeriodType {
  halves
  quarters
}

enum SportType {
  cbb
  nba
  nfl
}

enum GridType {
  standard
  double
}

enum BoardType {
  game
  fundraiser

  @@map("board_type")
}

enum DrawTrigger {
  date
  when_full

  @@map("draw_trigger")
}

enum SupporterStatus {
  pending
  active

  @@map("supporter_status")
}

enum AdmissionGrantSource {
  FUNDRAISER
  STANDALONE
  GATE_ALLOWANCE
  HOST_APPROVED

  @@map("admission_grant_source")
}

/// `void` is terminal. A voided pass never returns to active under any path.
enum AdmissionPassStatus {
  active
  used
  void

  @@map("admission_pass_status")
}

enum CheckInAction {
  check_in
  undo

  @@map("check_in_action")
}


enum credit_tx_type {
  signup_grant
  purchase
  admin_grant
  board_created
}
