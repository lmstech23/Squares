generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Host {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  /// Nullable and not unique, matching the database. Four of five hosts hold
  /// '' — a surrogate for a value the product never supplied. Whether a host's
  /// email belongs here or in auth.users is an open product decision tracked in
  /// PHASE-2-BACKLOG.md; the schema must not assert an answer it does not have.
  email                  String?
  stripeAccountId        String?             @map("stripe_account_id")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supabaseUserId         String?  @unique @map("supabase_user_id")
  stripeChargesEnabled   Boolean?  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean?  @default(false) @map("stripe_payouts_enabled")
  boardCredits           Int                 @default(2) @map("board_credits")
  boards                 Board[]
  creditTransactions     CreditTransaction[]
  invite_codes           InviteCode[]

  paymentPreference         String?             @map("payment_preference")

  @@map("hosts")
}

model Board {
  boardId                   String      @id @default(dbgenerated("gen_random_uuid()")) @map("board_id") @db.Uuid
  hostId                    String      @map("host_id") @db.Uuid
  gameName                  String      @map("game_name")
  squarePrice               Int         @map("square_price")
  totalSquares              Int         @default(100) @map("total_squares")
  status                    BoardStatus @default(open)
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  slug                      String      @unique
  rowNumbers                Int[]       @default([]) @map("row_numbers")
  colNumbers                Int[]       @default([]) @map("col_numbers")
  payoutStructure           Json?       @map("payout_structure")
  maxSquaresPerPlayer       Int         @default(10) @map("max_squares_per_player")
  boardCloseTime            DateTime?   @map("board_close_time") @db.Timestamptz(6)
  hostPayoutResponsible     Boolean     @default(true) @map("host_payout_responsible")
  currency                  String      @default("USD")
  teamRow                   String?     @map("team_row")
  teamCol                   String?     @map("team_col")
  periodType                PeriodType  @default(halves) @map("period_type")
  periodLabels              String[]    @default(["H1", "Final"]) @map("period_labels")
  sportType                 SportType   @default(cbb)       @map("sport_type")
  gridType                  GridType    @default(standard)  @map("grid_type")
  rowPairs                  Json?       @map("row_pairs")
  colPairs                  Json?       @map("col_pairs") 
  scoresTeamA               Int[]       @map("scores_team_a")
  scoresTeamB               Int[]       @map("scores_team_b")
  hostCutPercent            Int         @default(0) @map("host_cut_percent")
  cashModeEnabled           Boolean     @default(false) @map("cash_mode_enabled")
  cashPin                   String?     @map("cash_pin")
  cashReservationTtlMins    Int         @default(20) @map("cash_reservation_ttl_mins")
  cashLiabilityAccepted     Boolean     @default(false) @map("cash_liability_accepted")
  winnerNotifiedByPeriod  Json    @default("{}") @map("winner_notified_by_period")
  hostVenmo              String?          @map("host_venmo")
  hostZelle              String?          @map("host_zelle")
  hostCashapp            String?          @map("host_cashapp")
  hostPaypal             String?          @map("host_paypal")
  payoutVisibility       PayoutVisibility @default(public) @map("payout_visibility")
  requirePlayerPayout    Boolean          @default(false) @map("require_player_payout")
  scores                    Json?

  // Monetization lifecycle
  pendingExpiresAt          DateTime?   @map("pending_expires_at") @db.Timestamptz(6)
  expiredAt                 DateTime?   @map("expired_at") @db.Timestamptz(6)
  activatedAt               DateTime?   @map("activated_at") @db.Timestamptz(6)

  // Dismiss feature (Addendum K) � soft-hide from host dashboard
  hiddenFromHost            Boolean     @default(false) @map("hidden_from_host")

  // Fundraiser boards — fundraiser-board-v2.md §3
  // drawTrigger/drawDate/timezone are nullable at the DB level and required
  // by API validation on prize boards only (percent > 0) — the doc's "required"
  // is conditional, so it cannot be a NOT NULL column.
  boardType                 BoardType    @default(game) @map("board_type")
  causeDescription          String?      @map("cause_description")
  prizePoolPercent          Int          @default(0) @map("prize_pool_percent")
  prizeTierCount            Int          @default(4) @map("prize_tier_count")
  drawTrigger               DrawTrigger? @map("draw_trigger")
  drawDate                  DateTime?    @map("draw_date") @db.Timestamptz(6)
  timezone                  String?
  cashHoldDays              Int          @default(7) @map("cash_hold_days")
  finalRaisedCents          Int?         @map("final_raised_cents")
  finalPrizePoolCents       Int?         @map("final_prize_pool_cents")
  /// The prize basis at finalization — confirmed SQUARE money only, donations
  /// excluded. Money doc invariant 2 as amended; donations invariant 68.
  ///
  /// NULL ON BOARDS FINALIZED BEFORE A1. Their basis cannot be reconstructed:
  /// the split between square and donation money was never recorded because
  /// donations did not exist. A1 does not backfill it — donations §13.3.
  finalPrizeBasisCents      Int?         @map("final_prize_basis_cents")
  drawnAt                   DateTime?    @map("drawn_at") @db.Timestamptz(6)
  drawResults               Json?        @map("draw_results")
  titleHistory              Json?        @map("title_history")
  // Campaign backstop — required on fundraiser boards, API-enforced.
  // drawDate no longer doubles as the campaign end now that prizes are Phase B.
  campaignEndsAt            DateTime?    @map("campaign_ends_at") @db.Timestamptz(6)
  /// Optional, host-entered. Null = no goal and no progress bar. Not locked by
  /// invariant 16 — a goal is aspirational, not a term of the deal. v2 §7.
  fundraisingGoalCents      Int?         @map("fundraising_goal_cents")
  // Early bird — money doc §8B. Null price = flat pricing.
  earlyBirdPriceCents       Int?         @map("early_bird_price_cents")
  earlyBirdEndsAt           DateTime?    @map("early_bird_ends_at") @db.Timestamptz(6)

  host                      Host        @relation(fields: [hostId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  squares                   Square[]
  freeEntries               FreeEntry[]
  event                     Event?
  creditTransactions        CreditTransaction[]
  contributions             Contribution[]

  /// Two PARTIAL indexes exist on this table and are deliberately NOT
  /// declared here: idx_boards_pending_expiry (WHERE status = pending_payment)
  /// and idx_boards_expired_cleanup (WHERE status = expired). Prisma 6.19.2
  /// cannot represent a predicate, so declaring them as plain @@index made
  /// migrate diff propose recreating them unqualified forever — a name
  /// collision that would also silently widen the index. They are defined in
  /// prisma/migrations/0_init/migration.sql.
  ///
  /// ON A PRISMA UPGRADE: do NOT auto-convert these to declarations. Compare
  /// each PHYSICAL predicate (pg_get_indexdef) against what the new Prisma
  /// would generate, one index at a time, BEFORE changing anything here. A
  /// declaration that does not reproduce the predicate exactly is worse than
  /// no declaration — it silently widens the index.
  @@map("boards")
}

model Square {
  squareId          String            @id @default(dbgenerated("gen_random_uuid()")) @map("square_id") @db.Uuid
  boardId           String            @map("board_id") @db.Uuid
  position          Int
  playerName        String?           @map("player_name")
  playerEmail       String?           @map("player_email")
  paymentStatus     PaymentStatus     @default(open) @map("payment_status")
  stripePaymentId   String?           @map("stripe_payment_id")
  checkoutExpiresAt DateTime?         @map("checkout_expires_at") @db.Timestamptz(6)
  releaseReason     ReleaseReason?    @map("release_reason")
  reservedByHost    Boolean?          @default(false) @map("reserved_by_host")
  paymentMethod     PaymentMethod     @default(stripe) @map("payment_method")
  playerPhone           String?              @map("player_phone")
  playerPayoutMethod    PlayerPayoutMethod?  @map("player_payout_method")
  playerPayoutHandle    String?              @map("player_payout_handle")
  smsOptIn              Boolean              @default(false) @map("sms_opt_in")

  // Fundraiser boards — fundraiser-board-v2.md §3
  holdExpiresAt     DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  checkoutSessionId String?           @map("checkout_session_id")
  batchId           String?           @map("batch_id")
  isHostEntry       Boolean           @default(false) @map("is_host_entry")
  /// When the square left `open`. Written alongside pricePaidCents and never
  /// recomputed. PaymentReference.timestamp is the CONFIRMATION moment, which
  /// covers exactly the rows that do not need a date — an awaiting row is the
  /// one a host chases. v2 §9.
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  /// Stamped once this square has been included in a confirmation email. The
  /// unit is the confirmation EVENT, not the square — addendum §5.
  confirmationEmailedAt DateTime?     @map("confirmation_emailed_at") @db.Timestamptz(6)
  /// Written when the square leaves `open` — at claim or cash reservation —
  /// and never recomputed. `raised` sums this, never count × price. Inv. 42–44.
  /// Nullable because an `open` square has no price yet.
  pricePaidCents    Int?              @map("price_paid_cents")
  /// The owning contribution. Nullable while `open` — an open square belongs to
  /// nobody, including one that still carries a stale `batchId` from a released
  /// hold. Donations §13.1.
  contributionId    String?           @map("contribution_id") @db.Uuid

  contribution      Contribution?     @relation(fields: [contributionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment           PaymentReference?
  board             Board             @relation(fields: [boardId], references: [boardId], onDelete: Restrict, onUpdate: NoAction)
  /// Back-relation only. The foreign key lives on admission_passes; the
  /// squares table gains no column. Addendum: admission adds none to Square.
  admissionPasses   AdmissionPass[]

  @@unique([boardId, position])
  @@index([boardId, playerEmail], map: "idx_squares_board_email")
  @@index([batchId], map: "idx_squares_batch")
  @@index([contributionId], map: "idx_squares_contribution")
  @@index([boardId, claimedAt], map: "idx_squares_claimed_at")
  @@map("squares")
}

/// Free entries occupy no square, so they cannot be Square rows — v2 §3.
/// Built now, not surfaced in the UI. The `F` sequence is the only sequential
/// counter in the system, and (boardId, sequenceNumber) is the one uniqueness
/// constraint money doc §5 actually calls for.
model FreeEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId        String    @map("board_id") @db.Uuid
  sequenceNumber Int       @map("sequence_number")
  name           String
  phone          String
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  board          Board     @relation(fields: [boardId], references: [boardId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([boardId, sequenceNumber], map: "free_entries_board_sequence_key")
  @@map("free_entries")
}

//
// Event admission — fundraiser-admission-addendum.md §2 (build step A1b).
// Nothing below is read by any code path yet. Admission is deliberately kept
// off Board, Square, and Host: no column is added to any of them.
//

/// At most one event per board. May start before, on, or after drawDate —
/// no constraint between them.
model Event {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId                  String    @unique @map("board_id") @db.Uuid
  name                     String?
  startsAt                 DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime? @map("ends_at") @db.Timestamptz(6)
  timezone                 String
  venue                    String?
  /// Unused since addendum v2.0 — one square mints one pass, there is no
  /// ceiling. Retained rather than dropped; nullable so event creation does
  /// not have to invent a value.
  maxAttendeesPerSupporter Int?      @map("max_attendees_per_supporter")
  /// Reserved — never read in Phase A. See addendum §5.
  gateAllowanceTotal       Int       @default(0) @map("gate_allowance_total")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  board            Board             @relation(fields: [boardId], references: [boardId], onDelete: NoAction, onUpdate: NoAction)
  supporters       EventSupporter[]
  grants           AdmissionGrant[]
  checkinStaff     CheckinStaffAccess[]
  checkInLogs      CheckInLog[]
  signupSheet      SignupSheet?

  @@map("events")
}

/// The roster unit and the owner of passes. identityKey is the purchaser email,
/// lowercased and trimmed — two purchases with the same email are one supporter
/// with one allowance between them. status is a latch: pending -> active, never back.
model EventSupporter {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String          @map("event_id") @db.Uuid
  identityKey        String          @map("identity_key")
  name               String
  email              String
  /// Nullable — the claim flow does not require a phone (Square.playerPhone is
  /// nullable too), and preparation must not fail for a contributor without one.
  phone              String?
  declaredCount      Int             @default(0) @map("declared_count")
  /// Monotonic. Never decremented, never reset. Values are never reused.
  passSequenceCursor Int             @default(0) @map("pass_sequence_cursor")
  status             SupporterStatus @default(pending)
  activatedAt        DateTime?       @map("activated_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  event   Event                     @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grants  AdmissionGrant[]
  passes  AdmissionPass[]
  tokens  SupporterAccessToken[]
  signups HelperSignup[]
  signupLogs SignupLog[]
  notifications NotificationDelivery[]

  @@unique([eventId, identityKey], map: "event_supporters_event_identity_key")
  @@map("event_supporters")
}

/// Provenance. One row per purchase that touched admission, written even when
/// it declares 0 so the headcount is auditable rather than inferred from absence.
model AdmissionGrant {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String               @map("event_id") @db.Uuid
  eventSupporterId   String               @map("event_supporter_id") @db.Uuid
  /// Links to Square.batchId. Unique where not null — this is what makes the
  /// claim-time preparation step idempotent under retry.
  squareBatchId      String?              @map("square_batch_id")
  /// Supersedes `squareBatchId`. Retained-and-deprecated: A1 is additive and
  /// drops nothing, so both exist until a later migration removes the legacy
  /// column. Donations §13.
  contributionId     String?              @map("contribution_id") @db.Uuid
  /// Only FUNDRAISER is populated now. The rest exist so adding them later is
  /// a code path, not a migration.
  source             AdmissionGrantSource @default(FUNDRAISER)
  /// True mints no passes for this purchase and excludes the supporter from
  /// the headcount — the "I'm not attending" checkbox. Addendum v2.0 §1.
  donateAdmissions   Boolean              @default(false) @map("donate_admissions")
  /// Unused since v2.0 removed the declaration model. Retained, nullable.
  declaredAtPurchase Int?                 @map("declared_at_purchase")
  /// The help checkbox. INTENT ONLY — it never claims, reserves or holds a
  /// slot (invariant 36). Interest is a one-way OR across grants, read as
  /// EXISTS (grant WHERE wantsToHelp), never stored on the supporter.
  /// Sign-up addendum §4.
  wantsToHelp        Boolean              @default(false) @map("wants_to_help")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  event     Event          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supporter EventSupporter @relation(fields: [eventSupporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([squareBatchId], map: "admission_grants_square_batch_key")
  @@unique([contributionId], map: "admission_grants_contribution_key")
  @@index([eventSupporterId], map: "idx_admission_grants_supporter")
  @@map("admission_grants")
}

/// Passes hang off the supporter, not the purchase. Every pass carries its own
/// token whether or not it is ever named — a shared, unidentified QR is one
/// screenshot away from admitting six people.
model AdmissionPass {
  id                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventSupporterId              String              @map("event_supporter_id") @db.Uuid
  /// Internal, not the displayed ordinal. Drawn from passSequenceCursor.
  /// The square that minted this pass. Audit only. Nullable because deferred
  /// non-square sources (STANDALONE, GATE_ALLOWANCE, HOST_APPROVED) mint none.
  squareId                      String?             @map("square_id") @db.Uuid
  sequenceNumber                Int                 @map("sequence_number")
  token                         String              @unique
  label                         String?
  status                        AdmissionPassStatus @default(active)
  checkedInAt                   DateTime?           @map("checked_in_at") @db.Timestamptz(6)
  /// Foreign key, never a bearer token. No raw credential is stored anywhere.
  checkedInByCheckinStaffId     String?             @map("checked_in_by_volunteer_access_id") @db.Uuid
  createdAt                     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  supporter       EventSupporter   @relation(fields: [eventSupporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  square          Square?          @relation(fields: [squareId], references: [squareId], onDelete: NoAction, onUpdate: NoAction)
  checkedInBy     CheckinStaffAccess? @relation(fields: [checkedInByCheckinStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkInLogs     CheckInLog[]

  /// The constraint behind concurrency-safe activation: concurrent confirmation
  /// cannot double-mint. Safe because the cursor never reuses a value.
  @@unique([eventSupporterId, sequenceNumber], map: "admission_passes_supporter_sequence_key")
  @@index([squareId], map: "idx_admission_passes_square")
  @@map("admission_passes")
}

/// Undo has to be auditable or the host stops trusting the count.
model CheckInLog {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId               String        @map("pass_id") @db.Uuid
  eventId              String        @map("event_id") @db.Uuid
  action               CheckInAction
  at                   DateTime      @default(now()) @db.Timestamptz(6)
  byCheckinStaffId     String        @map("by_volunteer_access_id") @db.Uuid

  pass       AdmissionPass   @relation(fields: [passId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event      Event           @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  byCheckinStaff CheckinStaffAccess @relation(fields: [byCheckinStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([eventId, at], map: "idx_check_in_logs_event_at")
  @@index([passId], map: "idx_check_in_logs_pass")
  @@map("check_in_logs")
}

/// Check-in staff — authority to scan at the gate. That is a permission, not a
/// contribution, which is why this is no longer called "volunteer": the person
/// bringing water is a volunteer, the person authorized to scan is staff.
/// Sign-up addendum §2.
///
/// Scoped to one event, revocable individually, grants roster read and check-in
/// only. tokenHash is hashed at rest — the raw link is shown once at creation
/// and never stored, so a database read never yields a working credential.
///
/// MAPPED, NOT MIGRATED. The physical table is still `volunteer_access` and
/// holds issued records. A physical rename during a rolling deploy would leave
/// old instances querying an object that no longer exists, and that failure
/// surfaces at a gate, at an event, in front of a line. Physical rename is a
/// separate ticket for a planned window.
model CheckinStaffAccess {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  label     String
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event           @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkedInPasses AdmissionPass[]
  checkInLogs  CheckInLog[]

  @@index([eventId], map: "idx_volunteer_access_event")
  @@map("volunteer_access")
}

/// Supporter-scoped access link — sign-up addendum §3.
///
/// REUSABLE, not single-use. A supporter returns to this link to change her
/// commitment, and §5b's SIGNUP_LINK dedupe key is `supporter:{id}` precisely so
/// a second contribution does not mail a second copy of a link she already has.
/// `usedAt` is gone: a token burned on first open contradicts both.
///
/// PHYSICALLY RENAMED from `attendance_access_tokens`, unlike the S0 rename
/// which pinned with @@map. S0 pinned because `volunteer_access` held issued
/// records and a rolling deploy would break the gate mid-event. This table had
/// zero rows and zero code references, so there was nothing to break and
/// pinning would have left a third naming layer.
///
/// `expiresAt` is event-lifecycle based, not a short fixed window — the link
/// must work from confirmation until the host stops needing helpers, which is
/// weeks. The exact expression is an S3 decision; S1 only needs the column.
model SupporterAccessToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventSupporterId String    @map("event_supporter_id") @db.Uuid
  /// Hashed at rest. A database read never yields a working credential.
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  supporter EventSupporter @relation(fields: [eventSupporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([eventSupporterId], map: "idx_supporter_access_tokens_supporter")
  @@map("supporter_access_tokens")
}

model PaymentReference {
  paymentId       String        @id @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  squareId        String        @unique @map("square_id") @db.Uuid
  stripeSessionId String?       @unique @map("stripe_session_id")
  amount          Int
  timestamp       DateTime      @default(now()) @db.Timestamptz(6)
  method          PaymentMethod @default(stripe)
  square          Square        @relation(fields: [squareId], references: [squareId], onDelete: Restrict, onUpdate: NoAction)

  @@map("payment_references")
}

model InviteCode {
  code      String    @id
  email     String?
  claimedBy String?   @map("claimed_by") @db.Uuid
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  hosts     Host?     @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invite_codes")
}

model CreditTransaction {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId          String         @map("host_id") @db.Uuid
  type            credit_tx_type
  amount          Int
  balanceAfter    Int            @map("balance_after")
  /// NOT @unique here. The physical index is PARTIAL
  /// (credit_transactions_stripe_session_id_key ... WHERE stripe_session_id IS
  /// NOT NULL) and Prisma 6.19.2 cannot express the predicate. Declaring
  /// @unique asserted a plain unique index that does not exist and made every
  /// migrate dev generate a colliding CREATE. Defined in 0_init.
  /// On a Prisma upgrade, compare the physical predicate against what the new
  /// version would generate before re-adding @unique. Do not auto-convert.
  /// PaymentReference.stripeSessionId keeps its @unique — that index is real.
  stripeSessionId String?        @map("stripe_session_id")
  boardId         String?        @map("board_id") @db.Uuid
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  host            Host           @relation(fields: [hostId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board           Board?         @relation(fields: [boardId], references: [boardId], onDelete: SetNull, onUpdate: NoAction)

  @@index([hostId, createdAt], map: "idx_credit_tx_host_created")
  @@map("credit_transactions")
}

enum BoardStatus {
  open
  closed
  pending_payment
  expired
  /// Fundraiser only — money doc §7. Reconciliation phase between the campaign
  /// ending and finalRaisedCents being written. New claims are rejected;
  /// nothing is final yet. Game Day never enters it.
  closing
}

enum PaymentStatus {
  open
  pending
  reserved_cash
  paid
  failed
  expired
}

enum ReleaseReason {
  expired
  failed
  manual
}

/// The money primitive. Donations addendum §5.
///
/// EVERY COUNTED DOLLAR BELONGS TO EXACTLY ONE ROW — invariant 51. `raisedCents`
/// is computed from contributions, never from squares. `Contribution.id` IS the
/// batch identity and replaces `Square.batchId`, retained-and-deprecated until a
/// later migration drops it.
///
/// STATUS IS THE PAYMENT LIFECYCLE ONLY. There is no `voided` status: a void sets
/// `voidedAt` and leaves `status` alone, so a voided contribution stays visible as
/// what it was. Anything computing money must test BOTH `status = 'confirmed'`
/// AND `voidedAt IS NULL` — forgetting the second silently resurrects voided
/// money into totals.
model Contribution {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId             String             @map("board_id") @db.Uuid
  status              ContributionStatus @default(pending)
  /// Reuses the existing `PaymentMethod` enum (`stripe` | `cash`). Donations §5
  /// writes "card"; the physical enum has said `stripe` since 0_init, and a
  /// second enum meaning the same thing is worse than the wording gap.
  paymentMethod       PaymentMethod      @map("payment_method")

  squareAmountCents   Int                @default(0) @map("square_amount_cents")
  donationAmountCents Int                @default(0) @map("donation_amount_cents")
  totalPaidCents      Int                @map("total_paid_cents")

  checkoutSessionId   String?            @map("checkout_session_id")
  holdExpiresAt       DateTime?          @map("hold_expires_at") @db.Timestamptz(6)

  contributorName     String             @map("contributor_name")
  contributorEmail    String?            @map("contributor_email")
  contributorPhone    String?            @map("contributor_phone")

  /// Money doc invariant 15 — counts toward raised, never drawing-eligible.
  /// DISTINCT FROM `recordedByHostId`: that is who ENTERED the row, this is
  /// whose MONEY it is. Conflating them disqualifies every walk-up contributor
  /// a host keys in. Collaborators §6.3.
  isHostEntry         Boolean            @default(false) @map("is_host_entry")
  /// Reserved, unread in this phase. Donations §10.
  displayAnonymous    Boolean            @default(false) @map("display_anonymous")

  confirmedAt         DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  releasedAt          DateTime?          @map("released_at") @db.Timestamptz(6)

  /// Cash only. Who entered the record — split from who confirmed receipt.
  recordedByHostId    String?            @map("recorded_by_host_id") @db.Uuid
  confirmedByHostId   String?            @map("confirmed_by_host_id") @db.Uuid

  /// Cash-donation void, donations §7. `voidedAt` is write-once and never
  /// changes `status`.
  voidedAt            DateTime?          @map("voided_at") @db.Timestamptz(6)
  voidedByHostId      String?            @map("voided_by_host_id") @db.Uuid
  voidReason          String?            @map("void_reason")

  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  board          Board           @relation(fields: [boardId], references: [boardId], onDelete: Restrict, onUpdate: NoAction)
  squares        Square[]
  admissionGrant AdmissionGrant?

  @@unique([checkoutSessionId], map: "contributions_checkout_session_key")
  @@index([boardId, status], map: "idx_contributions_board_status")
  @@map("contributions")
}

enum ContributionStatus {
  pending
  confirmed
  released

  @@map("contribution_status")
}

