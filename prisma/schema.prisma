generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Host {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?
  email                  String   @unique
  stripeAccountId        String?             @map("stripe_account_id")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  supabaseUserId         String?  @unique @map("supabase_user_id")
  stripeChargesEnabled   Boolean?  @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean?  @default(false) @map("stripe_payouts_enabled")
  boardCredits           Int                 @default(2) @map("board_credits")
  boards                 Board[]
  creditTransactions     CreditTransaction[]
  invite_codes           InviteCode[]

  @@map("hosts")
}

model Board {
  boardId                   String      @id @default(dbgenerated("gen_random_uuid()")) @map("board_id") @db.Uuid
  hostId                    String      @map("host_id") @db.Uuid
  gameName                  String      @map("game_name")
  squarePrice               Int         @map("square_price")
  totalSquares              Int         @default(100) @map("total_squares")
  status                    BoardStatus @default(open)
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  slug                      String      @unique
  rowNumbers                Int[]       @default([]) @map("row_numbers")
  colNumbers                Int[]       @default([]) @map("col_numbers")
  payoutStructure           Json?       @map("payout_structure")
  maxSquaresPerPlayer       Int         @default(10) @map("max_squares_per_player")
  boardCloseTime            DateTime?   @map("board_close_time") @db.Timestamptz(6)
  hostPayoutResponsible     Boolean     @default(true) @map("host_payout_responsible")
  currency                  String      @default("USD")
  teamRow                   String?     @map("team_row")
  teamCol                   String?     @map("team_col")
  periodType                PeriodType  @default(halves) @map("period_type")
  periodLabels              String[]    @default(["H1", "Final"]) @map("period_labels")
  scoresTeamA               Int[]       @map("scores_team_a")
  scoresTeamB               Int[]       @map("scores_team_b")
  hostCutPercent            Int         @default(0) @map("host_cut_percent")
  cashModeEnabled           Boolean     @default(false) @map("cash_mode_enabled")
  cashPin                   String?     @map("cash_pin")
  cashReservationTtlMins    Int         @default(20) @map("cash_reservation_ttl_mins")
  cashLiabilityAccepted     Boolean     @default(false) @map("cash_liability_accepted")
  paymentPreference  String?  @map("payment_preference")
  scores                    Json?

  // Monetization lifecycle
  pendingExpiresAt          DateTime?   @map("pending_expires_at") @db.Timestamptz(6)
  expiredAt                 DateTime?   @map("expired_at") @db.Timestamptz(6)
  activatedAt               DateTime?   @map("activated_at") @db.Timestamptz(6)

  host                      Host        @relation(fields: [hostId], references: [id], onUpdate: NoAction)
  squares                   Square[]
  creditTransactions        CreditTransaction[]

  @@index([pendingExpiresAt], map: "idx_boards_pending_expiry")
  @@index([expiredAt], map: "idx_boards_expired_cleanup")
  @@map("boards")
}

model Square {
  squareId          String            @id @default(dbgenerated("gen_random_uuid()")) @map("square_id") @db.Uuid
  boardId           String            @map("board_id") @db.Uuid
  position          Int
  playerName        String?           @map("player_name")
  playerEmail       String?           @map("player_email")
  paymentStatus     PaymentStatus     @default(open) @map("payment_status")
  stripePaymentId   String?           @map("stripe_payment_id")
  checkoutExpiresAt DateTime?         @map("checkout_expires_at") @db.Timestamptz(6)
  releaseReason     ReleaseReason?    @map("release_reason")
  reservedByHost    Boolean?          @default(false) @map("reserved_by_host")
  paymentMethod     PaymentMethod     @default(stripe) @map("payment_method")
  payment           PaymentReference?
  board             Board             @relation(fields: [boardId], references: [boardId], onUpdate: NoAction)

  @@unique([boardId, position])
  @@index([boardId, playerEmail], map: "idx_squares_board_email")
  @@map("squares")
}

model PaymentReference {
  paymentId       String        @id @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  squareId        String        @unique @map("square_id") @db.Uuid
  stripeSessionId String?       @unique @map("stripe_session_id")
  amount          Int
  timestamp       DateTime      @default(now()) @db.Timestamptz(6)
  method          PaymentMethod @default(stripe)
  square          Square        @relation(fields: [squareId], references: [squareId], onUpdate: NoAction)

  @@map("payment_references")
}

model InviteCode {
  code      String    @id
  email     String?
  claimedBy String?   @map("claimed_by") @db.Uuid
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  hosts     Host?     @relation(fields: [claimedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invite_codes")
}

model CreditTransaction {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId          String         @map("host_id") @db.Uuid
  type            credit_tx_type
  amount          Int
  balanceAfter    Int            @map("balance_after")
  stripeSessionId String?        @unique @map("stripe_session_id")
  boardId         String?        @map("board_id") @db.Uuid
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  host            Host           @relation(fields: [hostId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  board           Board?         @relation(fields: [boardId], references: [boardId], onDelete: SetNull, onUpdate: NoAction)

  @@index([hostId, createdAt], map: "idx_credit_tx_host_created")
  @@map("credit_transactions")
}

enum BoardStatus {
  open
  closed
  pending_payment
  expired
}

enum PaymentStatus {
  open
  pending
  reserved_cash
  paid
  failed
  expired
}

enum ReleaseReason {
  expired
  failed
  manual
}

enum PaymentMethod {
  stripe
  cash
}

enum PeriodType {
  halves
  quarters
}

enum credit_tx_type {
  signup_grant
  purchase
  admin_grant
  board_created
}
