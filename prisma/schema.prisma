// ============================================================
// SQUARES — Prisma Schema
// 4 objects + cash reservation support. Locked before writing code.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum BoardStatus {
  open
  closed
}

enum PaymentStatus {
  open           // available square (no checkout started)
  pending        // Stripe checkout created, TTL running
  reserved_cash  // cash reservation — claimed but cash not yet confirmed by host
  paid           // Stripe checkout completed OR cash confirmed received by host
  failed         // Stripe reported failure
  expired        // checkout session expired / TTL cleanup
}

enum PaymentMethod {
  stripe  // paid via Stripe Checkout
  cash    // reserved/paid via cash mode
}

/// Internal debugging only. Tracks WHY a square was released.
/// Null when square is open or paid.
enum ReleaseReason {
  expired // Checkout TTL hit — player never completed payment
  failed  // Stripe reported a payment failure
  manual  // Host or admin manually released the square
}

// ============================================================
// OBJECT 1: HOST
// ============================================================

model Host {
  id              String   @id @default(uuid())
  name            String?  // allow null during magic-link-first flow
  email           String   @unique
  stripeAccountId String?  @map("stripe_account_id")
  createdAt       DateTime @default(now()) @map("created_at")

  boards Board[]

  @@map("hosts")
}

// ============================================================
// OBJECT 2: BOARD
// ============================================================

model Board {
  boardId      String      @id @default(uuid()) @map("board_id")
  hostId       String      @map("host_id")
  gameName     String      @map("game_name")
  squarePrice  Int         @map("square_price") // cents (1000 = $10)
  totalSquares Int         @default(100) @map("total_squares")
  status       BoardStatus @default(open)
  createdAt    DateTime    @default(now()) @map("created_at")
  slug         String      @unique

  // Null until board closes, then arrays of [0-9] shuffled
  rowNumbers   Int[]       @default([]) @map("row_numbers")
  colNumbers   Int[]       @default([]) @map("col_numbers")

  // --- Smart fields ---
  payoutStructure        Json?     @map("payout_structure")
  maxSquaresPerPlayer    Int       @default(10) @map("max_squares_per_player")
  boardCloseTime         DateTime? @map("board_close_time")
  hostPayoutResponsible  Boolean   @default(true) @map("host_payout_responsible")
  currency               String    @default("USD")

  // --- Cash mode ---
  cashModeEnabled        Boolean   @default(false) @map("cash_mode_enabled")
  cashPin                String?   @map("cash_pin")             // 4-digit PIN, null when cash mode off
  cashReservationTtlMins Int       @default(20) @map("cash_reservation_ttl_mins") // auto-expire unconfirmed cash reservations
  cashLiabilityAccepted  Boolean   @default(false) @map("cash_liability_accepted") // host acknowledged cash responsibility

  host    Host     @relation(fields: [hostId], references: [id])
  squares Square[]

  @@map("boards")
}

// ============================================================
// OBJECT 3: SQUARE
// ============================================================

model Square {
  squareId        String        @id @default(uuid()) @map("square_id")
  boardId         String        @map("board_id")
  position        Int
  playerName      String?       @map("player_name")
  playerEmail     String?       @map("player_email")
  paymentStatus   PaymentStatus @default(open) @map("payment_status")
  paymentMethod   PaymentMethod @default(stripe) @map("payment_method")
  stripePaymentId String?       @map("stripe_payment_id")

  checkoutExpiresAt DateTime?     @map("checkout_expires_at") // used for BOTH Stripe pending and cash reservations
  releaseReason     ReleaseReason? @map("release_reason")

  board   Board             @relation(fields: [boardId], references: [boardId])
  payment PaymentReference?

  @@unique([boardId, position])
  @@index([boardId, playerEmail], map: "idx_squares_board_email")
  @@map("squares")
}

// ============================================================
// OBJECT 4: PAYMENT REFERENCE
// ============================================================

model PaymentReference {
  paymentId       String   @id @default(uuid()) @map("payment_id")
  squareId        String   @unique @map("square_id")
  stripeSessionId String?  @unique @map("stripe_session_id") // nullable for cash payments
  amount          Int
  method          PaymentMethod @default(stripe)
  timestamp       DateTime @default(now())

  square Square @relation(fields: [squareId], references: [squareId])

  @@map("payment_references")
}
