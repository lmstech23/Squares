# ===========================================
# SQUARES — Environment Variables
# Copy this to .env and fill in real values
# ===========================================

# Supabase Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App
NEXT_PUBLIC_URL="http://localhost:3000"

# Hosts allowed to create Fundraiser boards — fundraiser-board-v2.md §14.
# Comma-separated emails. Unset or empty = nobody (closed by default).
# Remove the gate when A9 has shipped AND a ticket email exists. Both.
FUNDRAISER_HOSTS=""
